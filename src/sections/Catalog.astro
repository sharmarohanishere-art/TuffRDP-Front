---
import Container from '../components/ui/Container.astro';
import { operatingSystems } from '../data/catalog';
import { Icon } from 'astro-icon/components';

const linux = operatingSystems.filter((system) => system.family === 'Linux');
const windows = operatingSystems.filter((system) => system.family === 'Windows');
const initialSystem = operatingSystems.find((system) => system.recommended) ?? operatingSystems[0];
---

<section id="deploy" class="py-32 bg-surface-1 border-y border-border-subtle relative overflow-hidden">
  <Container class="relative z-10">
    
    <!-- Copy -->
    <div class="max-w-2xl mb-20">
      <p class="text-[0.72rem] font-mono tracking-wider text-primary uppercase mb-4">03 / Deployment</p>
      <h2 class="text-3xl md:text-4xl font-semibold text-text leading-tight mb-4">Start with the operating system your work already expects.</h2>
      <p class="text-text-muted text-lg mb-8">Windows RDP and Linux VPS options stay visible in the same compact deployment catalogue.</p>
      <a href="https://tuffrdp.com/en/windows-rdp" class="inline-flex items-center font-bold text-text hover:text-primary transition-colors group">
        Explore Windows RDP 
        <Icon name="lucide:arrow-right" class="w-4 h-4 ml-2 text-primary group-hover:translate-x-1 transition-transform" />
      </a>
    </div>

    <!-- Catalog -->
    <div class="grid lg:grid-cols-[1fr_1fr] gap-16 items-start" data-os-selector>
      
      <!-- OS Lists -->
      <div class="grid grid-cols-2 gap-12">
        
        <!-- Linux -->
        <div>
          <h3 class="text-[0.65rem] font-mono tracking-wider text-text-muted uppercase mb-6 border-b border-border pb-4">Linux Templates</h3>
          <div class="flex flex-col gap-2">
            {linux.map((system) => (
              <button type="button" class="os-option group w-full flex items-center gap-3 px-3 py-2 -ml-3 rounded hover:bg-surface-2 transition-all aria-pressed:bg-surface-2" data-name={system.name} data-family={system.family} aria-pressed={system.name === initialSystem.name ? 'true' : 'false'}>
                <img src={system.icon} width="20" height="20" alt="" class="opacity-70 group-hover:opacity-100 group-aria-pressed:opacity-100 transition-opacity" />
                <span class="text-sm font-medium text-text-subtle group-hover:text-text group-aria-pressed:text-text transition-colors">{system.name}</span>
                <div class="ml-auto w-1 h-4 rounded-full bg-signal opacity-0 group-aria-pressed:opacity-100 transition-opacity"></div>
              </button>
            ))}
          </div>
        </div>

        <!-- Windows -->
        <div>
          <h3 class="text-[0.65rem] font-mono tracking-wider text-text-muted uppercase mb-6 border-b border-border pb-4">Windows Templates</h3>
          <div class="flex flex-col gap-2">
            {windows.map((system) => (
              <button type="button" class="os-option group w-full flex items-center gap-3 px-3 py-2 -ml-3 rounded hover:bg-surface-2 transition-all aria-pressed:bg-surface-2" data-name={system.name} data-family={system.family} aria-pressed="false">
                <img src={system.icon} width="20" height="20" alt="" class="opacity-70 group-hover:opacity-100 group-aria-pressed:opacity-100 transition-opacity" />
                <span class="text-sm font-medium text-text-subtle group-hover:text-text group-aria-pressed:text-text transition-colors">{system.name}</span>
                <div class="ml-auto w-1 h-4 rounded-full bg-signal opacity-0 group-aria-pressed:opacity-100 transition-opacity"></div>
              </button>
            ))}
          </div>
        </div>
      </div>

      <!-- Preview Pane -->
      <aside class="relative flex flex-col h-full border-t lg:border-t-0 lg:border-l border-border pt-12 lg:pt-0 lg:pl-16" aria-live="polite">
        <p class="text-[0.65rem] font-mono tracking-wider text-primary uppercase mb-4">Selected template</p>
        <strong class="text-4xl font-semibold tracking-tight text-text mb-12" data-selected-name>{initialSystem.name}</strong>
        
        <dl class="grid grid-cols-2 gap-y-8 gap-x-4 mb-12">
          <div>
            <dt class="text-[0.65rem] font-mono tracking-wider text-text-muted uppercase mb-2">Family</dt>
            <dd class="text-sm font-mono text-text bg-surface-2 inline-flex px-2 py-1 rounded border border-border-subtle" data-selected-family>{initialSystem.family}</dd>
          </div>
          <div>
            <dt class="text-[0.65rem] font-mono tracking-wider text-text-muted uppercase mb-2">Availability</dt>
            <dd class="text-sm font-mono text-signal bg-signal/10 inline-flex px-2 py-1 rounded border border-signal/20">Ready to deploy</dd>
          </div>
          <div>
            <dt class="text-[0.65rem] font-mono tracking-wider text-text-muted uppercase mb-2">Virt. Type</dt>
            <dd class="text-sm font-mono text-text">KVM</dd>
          </div>
          <div>
            <dt class="text-[0.65rem] font-mono tracking-wider text-text-muted uppercase mb-2">Boot Mode</dt>
            <dd class="text-sm font-mono text-text">UEFI</dd>
          </div>
        </dl>
        
        <p class="text-sm text-text-muted leading-relaxed max-w-sm mt-auto">All templates are pre-configured with necessary drivers and optimization flags for immediate remote access upon deployment.</p>
      </aside>

    </div>
  </Container>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-os-selector]').forEach((selector) => {
    const name = selector.querySelector<HTMLElement>('[data-selected-name]');
    const family = selector.querySelector<HTMLElement>('[data-selected-family]');
    const options = selector.querySelectorAll<HTMLButtonElement>('.os-option');

    options.forEach((option) => option.addEventListener('click', () => {
      options.forEach((item) => item.setAttribute('aria-pressed', String(item === option)));
      if (name) name.textContent = option.dataset.name ?? '';
      if (family) family.textContent = option.dataset.family ?? '';
    }));
  });
</script>
