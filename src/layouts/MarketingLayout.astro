---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/marketing/Header.astro';
import Footer from '../components/marketing/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const { title, description, noindex } = Astro.props;
---

<BaseLayout title={title} description={description} noindex={noindex}>
  <a class="sr-only focus:not-sr-only focus:absolute focus:z-[100] focus:p-4 focus:bg-surface-1 focus:text-primary" href="#main-content">Skip to content</a>
  <Header />
  <main id="main-content">
    <slot />
  </main>
  <Footer />
</BaseLayout>
