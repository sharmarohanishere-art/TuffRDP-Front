---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import Hero from '../sections/Hero.astro';
import RdpAccess from '../sections/RdpAccess.astro';
import Features from '../sections/Features.astro';
import Catalog from '../sections/Catalog.astro';
import Pricing from '../sections/Pricing.astro';
import Faq from '../sections/Faq.astro';
---

<MarketingLayout
  title="Windows RDP Hosting"
  description="Deploy a dedicated Windows Server instance with full administrator access, Intel Xeon compute, NVMe storage, and a protected network."
>
  <Hero
    badge="Windows Server / Remote Desktop"
    heading="Windows RDP built for the desktop you actually work in."
    description="Full administrator access to a dedicated Windows Server instance—Intel Xeon compute, NVMe storage, and a protected network, ready the moment deployment completes."
    primaryCta={{ href: '#pricing', label: 'View Windows RDP plans' }}
    secondaryCta={{ href: '#access', label: 'How access works' }}
    visual="rdp"
  />
  <RdpAccess />
  <Features />
  <Catalog
    family="Windows"
    title="Every plan ships with a current Windows Server template."
    description="Choose the release your applications and licensing require."
    ctaHref=""
  />
  <Pricing />
  <Faq />
</MarketingLayout>
