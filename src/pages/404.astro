---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import Container from '../components/ui/Container.astro';
import Button from '../components/ui/Button.astro';
---

<MarketingLayout title="Page Not Found" noindex>
  <section class="not-found-section">
    <Container>
      <div class="content">
        <h1 class="title">404</h1>
        <h2 class="subtitle">Page not found</h2>
        <p class="description">Sorry, we couldn't find the page you're looking for.</p>
        <Button variant="primary" href="/">Go back home</Button>
      </div>
    </Container>
  </section>
</MarketingLayout>

<style>
  .not-found-section {
    padding: 8rem 0;
    text-align: center;
    min-height: 60vh;
    display: flex;
    align-items: center;
  }
  
  .content {
    max-width: 32rem;
    margin: 0 auto;
  }
  
  .title {
    font-size: 6rem;
    font-weight: 800;
    line-height: 1;
    color: var(--color-primary);
    margin-bottom: 1rem;
  }
  
  .subtitle {
    font-size: 2rem;
    font-weight: 700;
    margin-bottom: 1rem;
  }
  
  .description {
    font-size: 1.125rem;
    color: var(--color-text-subtle);
    margin-bottom: 2.5rem;
  }
</style>
