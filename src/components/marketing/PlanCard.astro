---
import Button from '../ui/Button.astro';
import type { Plan } from '../../data/home';
import { Icon } from 'astro-icon/components';

interface Props { plan: Plan; }
const { plan } = Astro.props;
---

<article class="group relative flex flex-col min-h-[25rem] p-8 bg-surface-1 rounded-xl border border-border overflow-hidden transition-all hover:border-primary/50 hover:shadow-2xl hover:shadow-primary/5">
  
  <!-- Subtle Spotlight Effect -->
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,var(--color-primary),transparent_50%)] opacity-0 group-hover:opacity-10 transition-opacity duration-500 pointer-events-none"></div>

  <p class="text-xl font-semibold text-text relative z-10">{plan.name}</p>
  
  <div class="flex flex-col gap-1 mt-6 mb-2 relative z-10">
    <span class="text-sm text-text-subtle">Starting from</span>
    <strong class="text-5xl font-semibold tracking-tight text-text flex items-start">
      <sup class="text-lg mt-1 mr-1">€</sup>{plan.price.toFixed(2)}
    </strong>
    <small class="text-[0.65rem] font-mono tracking-wider text-text-subtle uppercase">Monthly</small>
  </div>
  
  <div class="flex items-center gap-3 my-6 text-[0.65rem] font-mono tracking-wider text-primary uppercase relative z-10">
    <div class="h-px flex-1 bg-border-emphasis"></div>
    <span class="flex items-center gap-1.5"><Icon name="lucide:zap" class="w-3 h-3" /> Instant setup</span>
    <div class="h-px flex-1 bg-border-emphasis"></div>
  </div>
  
  <dl class="mb-8 relative z-10 flex-1">
    {plan.specs.map((spec) => (
      <div class="flex justify-between items-center py-3 border-b border-border-subtle last:border-b-0">
        <dt class="text-[0.65rem] font-mono tracking-wider text-text-muted uppercase">{spec.label}</dt>
        <dd class="text-sm font-semibold text-text m-0">{spec.value}</dd>
      </div>
    ))}
  </dl>
  
  <div class="relative z-10 mt-auto">
    <Button href="https://tuffrdp.com/en/windows-rdp" variant="outline" class="w-full justify-center group-hover:bg-primary group-hover:text-bg group-hover:border-primary transition-all">Select configuration</Button>
  </div>
</article>
