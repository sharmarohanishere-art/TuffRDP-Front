---
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---
<div class={`container ${className}`}>
  <slot />
</div>

<style>
  .container {
    width: 100%;
    max-width: var(--container-max);
    margin-left: auto;
    margin-right: auto;
    padding-left: var(--page-gutter);
    padding-right: var(--page-gutter);
  }
</style>
